{
    "version": "2.0.0",
    "tasks": [
        {
            "label": "run main",
            "type": "shell",
            "command": "cargo",
            "args": [
                "run",
                "--release",
                "--",
                "${input:graph}",
                "${input:snaplen}"
            ],
            "problemMatcher": [],
            "presentation": {
                "echo": true,
                "reveal": "always",
                "focus": true,
                "panel": "dedicated",
                "showReuseMessage": true,
                "clear": false
            }
        },
        {
            "label": "cargo build",
            "type": "shell",
            "command": "cargo",
            "args": [
                "build"
            ],
            "group": {
                "kind": "build",
                "isDefault": true
            },
            "problemMatcher": [
                "$rustc"
            ]
        }
    ],
    "inputs": [
        {
            "id": "graph",
            "type": "promptString",
            "description": "Path del grafo di input",
            "default": "/media/hd/rucci-hd/dataset/temporal/as-733/as-733-complete.txt"
        },
        {
            "id": "snaplen",
            "type": "promptString",
            "description": "Lunghezza in secondi degli snapshot",
            "default": "7"
        }
    ]
}